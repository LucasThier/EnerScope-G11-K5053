# Copy to .env and adjust for your environment.

# --- Database ---
DATASOURCE_DB=enerscope
DATASOURCE_USERNAME=enerscope
DATASOURCE_PASSWORD=enerscope
# Used when running the jar directly (not via docker-compose):
DATASOURCE_URL=jdbc:postgresql://localhost:5432/enerscope

# --- Logging ---
# TRACE < DEBUG < INFO < WARN < ERROR < OFF
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# --- JWT ---
# Must be at least 256 bits (32+ chars). Change this in production.
JWT_SECRET=dev-secret-change-in-production-must-be-at-least-256-bits-long!!
JWT_ACCESS_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=30

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Default admin seed ---
ADMIN_MAIL=admin@enerscope.org
ADMIN_PASSWORD=admin12345
ADMIN_FIRST_NAME=EnerScope
ADMIN_LAST_NAME=Admin
